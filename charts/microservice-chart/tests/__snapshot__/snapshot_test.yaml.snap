      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app.kubernetes.io/instance: myapp
          app.kubernetes.io/name: microservice-chart
          canaryDelivery: "false"
      strategy:
        rollingUpdate:
          maxSurge: 1
          maxUnavailable: 0
        type: RollingUpdate
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: myapp
            app.kubernetes.io/name: microservice-chart
            app.kubernetes.io/version: 1.0.0
            azure.workload.identity/use: "true"
            canaryDelivery: "false"
            critical: "true"
        spec:
          automountServiceAccountToken: false
          containers:
            - env: null
              image: ghcr.io/pagopa/devops-java-springboot-color:1.0.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 1
                httpGet:
                  path: /alive
                  port: 9999
                initialDelaySeconds: 1
                periodSeconds: 1
                successThreshold: 1
                terminationGracePeriodSeconds: 30
                timeoutSeconds: 1
