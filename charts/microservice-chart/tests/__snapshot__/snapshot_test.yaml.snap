nginx canary scenario:
  1: |
    raw: |
      1. Get the application URL by running these commands:
        export POD_NAME=$(kubectl get pods --namespace testit -l "app.kubernetes.io/name=microservice-chart,app.kubernetes.io/instance=myapp" -o jsonpath="{.items[0].metadata.name}")
        export CONTAINER_PORT=$(kubectl get pod --namespace testit $POD_NAME -o jsonpath="{.spec.containers[0].ports[0].containerPort}")
        echo "Visit http://127.0.0.1:8080 to use your application"
        kubectl --namespace testit port-forward $POD_NAME 8080:$CONTAINER_PORT
  2: |
    apiVersion: v1
    data:
      CANARY: "true"
      COLOR: blue
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: myapp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: microservice-chart
        app.kubernetes.io/version: 1.0.0
        azure.workload.identity/use: "true"
        canaryDelivery: "false"
        helm.sh/blueprint-version: 0.0.0-test
        helm.sh/chart: microservice-chart-1.0.0
      name: myapp-microservice-chart
      namespace: null
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        reloader.stakater.com/auto: "true"
      labels:
        app.kubernetes.io/instance: myapp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: microservice-chart
        app.kubernetes.io/version: 1.0.0
        azure.workload.identity/use: "true"
        canaryDelivery: "false"
        helm.sh/blueprint-version: 0.0.0-test
        helm.sh/chart: microservice-chart-1.0.0
      name: myapp-microservice-chart
      namespace: null
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app.kubernetes.io/instance: myapp
          app.kubernetes.io/name: microservice-chart
          canaryDelivery: "false"
      strategy:
        rollingUpdate:
          maxSurge: 1
          maxUnavailable: 0
        type: RollingUpdate
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: myapp
            app.kubernetes.io/name: microservice-chart
            app.kubernetes.io/version: 1.0.0
            azure.workload.identity/use: "true"
            canaryDelivery: "false"
            critical: "true"
        spec:
          automountServiceAccountToken: false
          containers:
            - env:
                - name: COLOR
                  valueFrom:
                    configMapKeyRef:
                      key: COLOR
                      name: myapp-microservice-chart
                - name: MY_KV_SECRET
                  valueFrom:
                    secretKeyRef:
                      key: my-kv-secret
                      name: myapp-microservice-chart
                - name: CANARY
                  valueFrom:
                    configMapKeyRef:
                      key: CANARY
                      name: myapp-microservice-chart
              image: ghcr.io/pagopa/devops-java-springboot-color:1.1.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 1
                httpGet:
                  path: /alive
                  port: 9999
                initialDelaySeconds: 1
                periodSeconds: 1
                successThreshold: 1
                terminationGracePeriodSeconds: 30
                timeoutSeconds: 1
              name: microservice-chart
              ports:
                - containerPort: 8080
                  name: app-port-8080
                  protocol: TCP
              readinessProbe:
                failureThreshold: 1
                httpGet:
                  path: /alive
                  port: 9999
                initialDelaySeconds: 1
                periodSeconds: 1
                successThreshold: 1
                timeoutSeconds: 1
              resources:
                limits:
                  cpu: 150m
                  memory: 128Mi
                requests:
                  cpu: 40m
                  memory: 96Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - all
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /mnt/secrets-store
                  name: secrets-store-inline
                  readOnly: true
          restartPolicy: Always
          securityContext:
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: default
          terminationGracePeriodSeconds: 30
          volumes:
            - emptyDir: {}
              name: tmp
            - csi:
                driver: secrets-store.csi.k8s.io
                readOnly: true
                volumeAttributes:
                  secretProviderClass: myapp-microservice-chart
              name: secrets-store-inline
  4: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      annotations:
        nginx.ingress.kubernetes.io/canary: "true"
        nginx.ingress.kubernetes.io/canary-by-header: X-Canary
        nginx.ingress.kubernetes.io/canary-by-header-value: enabled
        nginx.ingress.kubernetes.io/canary-weight: "10"
        nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
        nginx.ingress.kubernetes.io/proxy-body-size: 1m
        nginx.ingress.kubernetes.io/rewrite-target: /$2
        nginx.ingress.kubernetes.io/use-regex: "true"
      name: myapp-microservice-chart
      namespace: null
    spec:
      ingressClassName: nginx
      rules:
        - host: testit.itn.internal.devopslab.pagopa.it
          http:
            paths:
              - backend:
                  service:
                    name: myapp-microservice-chart
                    port:
                      number: 8080
                path: /testit/foo(/|$)(.*)
                pathType: ImplementationSpecific
      tls:
        - hosts:
            - testit.itn.internal.devopslab.pagopa.it
          secretName: testit-itn-internal-devopslab-pagopa-it
  5: |
