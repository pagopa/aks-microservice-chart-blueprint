        helm.sh/chart: microservice-chart-1.0.0
      name: myapp-microservice-chart
      namespace: null
    spec:
      advanced:
        horizontalPodAutoscalerConfig:
          name: hpa-myapp-microservice-chart
      cooldownPeriod: 300
      maxReplicaCount: 3
      minReplicaCount: 0
      pollingInterval: 10
      scaleTargetRef:
        name: myapp-microservice-chart
      triggers:
        - authenticationRef:
            name: azure-monitor-auth
          metadata:
            metricAggregationType: Count
            metricName: ServiceApiHit
            resourceGroupName: my-rg
            resourceURI: Microsoft.KeyVault/vaults/my-kv
            subscriptionId: 33333333-3333-3333-3333-333333333333
            targetValue: "30"
            tenantId: 22222222-2222-2222-2222-222222222222
          type: azure-monitor
        - authenticationRef:
            name: queue-auth
          metadata:
            queueLength: "5"
            queueName: my-queue
          type: azure-queue
  5: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        reloader.stakater.com/auto: "true"
      labels:
