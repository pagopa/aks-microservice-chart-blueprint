        export CONTAINER_PORT=$(kubectl get pod --namespace testit $POD_NAME -o jsonpath="{.spec.containers[0].ports[0].containerPort}")
        echo "Visit http://127.0.0.1:8080 to use your application"
        kubectl --namespace testit port-forward $POD_NAME 8080:$CONTAINER_PORT
